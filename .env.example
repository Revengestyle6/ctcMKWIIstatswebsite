# Safe local-development defaults. Copy to .env only if your shell tooling loads it.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://ctc_local:ctc_local@127.0.0.1:55432/ctc_dev
# Public project identifier used to verify real Firebase Google sign-in tokens.
FIREBASE_PROJECT_ID=mkw-stats
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_SECONDS=1800
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT_SECONDS=60
DB_APPLICATION_NAME=ctc-stats-local
POSTGRES_PORT=55432

# Local development only. Production must use Firebase ID tokens.
ALLOW_DEV_AUTH=false
# VITE_ALLOW_DEV_AUTH=true
# VITE_DEV_ADMIN_EMAIL=owner@example.com

ARCHIVE_STORAGE_PROVIDER=local
ARCHIVE_STORAGE_ROOT=backend/data/object_storage
# Production only: ARCHIVE_GCS_BUCKET=replace-during-deployment

MAX_REVIEW_SUBMISSION_BYTES=1048576
SUBMISSION_RATE_LIMIT=10
SUBMISSION_RATE_WINDOW_MINUTES=60
SUBMISSION_RATE_LIMIT_SECRET=replace-with-a-random-local-value

# Firebase web configuration (public identifiers, supplied at deployment).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
