# Cloud Build receives only the files copied by Dockerfile. This allowlist avoids
# uploading the large frontend/media/history tree or generated credentials.
**
!Dockerfile
!start.sh
!alembic.ini
!backend/
!backend/**

# Runtime images do not contain authoritative JSON, backups, tests, or local DBs.
backend/JSON/
backend/backups/
backend/test_*.py
backend/data/*.sqlite
backend/data/*.sqlite-*
backend/data/*.sqlite.*
backend/data/*.db
backend/data/*.db-*
backend/data/*.db.*
backend/data/object_storage/
backend/.venv*/
backend/**/.venv*/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
gha-creds-*.json
